# cp .env.example .env
#
# This file is for Docker Compose only. It is NOT read by dsh.
# Do not mount the compose repo as DSH_WORKSPACE (default is ./workspace).

# Image (GHCR default; or Docker Hub: stefankhor/dsh-docker:latest)
# DSH_IMAGE=ghcr.io/stefankhor/dsh-docker:latest

# HTTPS host port (nginx). Default 8443 -> https://host:8443
HTTPS_PORT=8443

# Optional browser basic auth at nginx (recommended).
# If AUTH_PASSWORD is empty, only dsh's own browser-session token protects the UI.
AUTH_USER=dsh
AUTH_PASSWORD=

# Only needed when reaching dsh directly on a non-loopback authority, bypassing
# the bundled nginx. Comma-separated host or host:port, e.g. 10.0.0.6:3080.
# Through nginx this can stay empty.
DSH_TRUSTED_HOSTS=

# Optional API key (or set later in the Web UI)
# DEEPSEEK_API_KEY=

# Agent project directory on the host (default: ./workspace next to compose)
# DSH_WORKSPACE=./workspace
# DSH_HOME_PATH=./dsh-home
