# cp .env.example .env

# HTTPS host port (nginx). Default 8443 → https://host:8443
HTTPS_PORT=8443

# Optional browser basic auth at nginx
AUTH_USER=dsh
AUTH_PASSWORD=

# LAN / reverse-proxy: comma-separated host or host:port the browser uses.
# Required to avoid /api HTTP 403 when not on localhost.
# Example: DSH_TRUSTED_HOSTS=10.0.0.6
# Example: DSH_TRUSTED_HOSTS=dsh.example.com,10.0.0.6
DSH_TRUSTED_HOSTS=

# Allow Models/settings/credentials APIs for trusted hosts (still need DSH_TRUSTED_HOSTS).
# Only enable behind HTTPS (+ optional AUTH_PASSWORD). Default 0 = loopback-only config plane.
DSH_ALLOW_REMOTE_CONFIGURATION=0

# Optional API key (or set later in the Web UI)
# DEEPSEEK_API_KEY=

# Optional data paths
# DSH_HOME_PATH=./dsh-home
# DSH_WORKSPACE=/path/to/your/project
