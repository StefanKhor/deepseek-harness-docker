# cp .env.example .env
#
# This file is for Docker Compose only. It is NOT read by dsh.
# Do not mount the compose repo as DSH_WORKSPACE (default is ./workspace).

# HTTPS host port (nginx). Default 8443 → https://host:8443
HTTPS_PORT=8443

# Optional browser basic auth at nginx
AUTH_USER=dsh
AUTH_PASSWORD=

# LAN / reverse-proxy: comma-separated host or host:port the browser uses.
# Required to avoid /api HTTP 403 when not on localhost.
# Example: DSH_TRUSTED_HOSTS=10.0.0.6
DSH_TRUSTED_HOSTS=

# Allow Models/settings/credentials APIs for trusted hosts.
# Must be set here (compose env), never inside the agent workspace .env
# Only enable behind HTTPS (+ optional AUTH_PASSWORD). Default 0.
DSH_ALLOW_REMOTE_CONFIGURATION=0

# Optional API key (or set later in the Web UI)
# DEEPSEEK_API_KEY=

# Agent project directory on the host (default: ./workspace next to compose)
# Do NOT set this to "." (the compose repo) or dsh will refuse launch-only vars in .env
# DSH_WORKSPACE=./workspace
# DSH_HOME_PATH=./dsh-home
