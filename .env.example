# cp .env.example .env

# HTTPS host port (nginx). Default 8443 → https://host:8443
# Use 443 for https://host (no port in URL)
HTTPS_PORT=8443

# Optional browser basic auth (leave empty = no password)
AUTH_USER=dsh
AUTH_PASSWORD=

# Optional data paths
# DSH_HOME_PATH=./dsh-home
# DSH_WORKSPACE=/path/to/your/project
